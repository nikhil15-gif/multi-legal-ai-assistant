# LegalSaathi AI Backend Configuration

# AI Provider Configuration
# Chat model provider: ollama, claude, openai
DEFAULT_AI_PROVIDER=ollama

# Voice transcription (Gemini auto-detects English, Hindi, Kannada, and code-switching)
VOICE_TRANSCRIPTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_SCRIPT_NORMALIZATION_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_TIMEOUT_SECONDS=90

# Ollama Settings (Default Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CPU_FALLBACK=false
OLLAMA_CPU_TIMEOUT_SECONDS=180
OLLAMA_CPU_NUM_PREDICT=512

# Optional Cloud AI API Keys (Not required for local demo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Document Storage & Security
MAX_UPLOAD_SIZE_MB=10
CLEANUP_TEMP_FILES=True
